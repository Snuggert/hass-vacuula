#!/usr/bin/env bash
set -e

echo "=== [pre-commit] Running linters and test suite ==="

# Locate Python environment
PY=""
if [ -n "$VIRTUAL_ENV" ] && [ -x "$VIRTUAL_ENV/bin/pytest" ]; then
    PY="$VIRTUAL_ENV/bin"
elif [ -d ".venv/bin" ] && [ -x ".venv/bin/pytest" ]; then
    PY=".venv/bin"
elif command -v pytest >/dev/null 2>&1; then
    PY=""
else
    echo "Warning: No pytest executable found. Skipping test check."
    exit 0
fi

if [ -n "$PY" ]; then
    RUFF="$PY/ruff"
    PYTEST="$PY/pytest"
else
    RUFF="ruff"
    PYTEST="pytest"
fi

# Run Ruff if available
if command -v "$RUFF" >/dev/null 2>&1 || [ -x "$RUFF" ]; then
    echo "-> Running ruff check..."
    "$RUFF" check .
    echo "-> Running ruff format check..."
    "$RUFF" format --check .
fi

# Run pytest
if command -v "$PYTEST" >/dev/null 2>&1 || [ -x "$PYTEST" ]; then
    echo "-> Running pytest (-n auto)..."
    "$PYTEST" -n auto tests/
fi

# Run Frontend checks (Biome, TypeScript, Vitest) if npm and package.json exist
if command -v npm >/dev/null 2>&1 && [ -f "package.json" ]; then
    echo "-> Running Biome JS lint & format check..."
    npm run lint
    echo "-> Running TypeScript typecheck..."
    npm run typecheck
    echo "-> Running Vitest frontend tests..."
    npm test
fi

echo "=== [pre-commit] All checks passed successfully! ==="
